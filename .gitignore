## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nupkg
**/packages/repositories.config

# Build logs
*.log
msbuild*.wrn
msbuild*.err

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# MAUI specific
*.appx
*.appxbundle
*.msix
*.msixbundle
