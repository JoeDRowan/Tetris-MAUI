<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tetris.Views.GamePage"
             Title="Tetris"
             BackgroundColor="#c8d4ec">

    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,*,Auto" Padding="10">

        <!-- Top Bar: End Game | Classic [Switch] Pro | New Game -->
        <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" HorizontalOptions="Center" Spacing="8" Margin="0,0,0,10" ZIndex="200">
            <Button x:Name="ExitGameButton" Text="End Game (E)" Clicked="OnExitGameClicked"
                    FontSize="12" BackgroundColor="#cc3333" TextColor="White"
                    Padding="10,5" IsVisible="False" VerticalOptions="Center"/>
            <Border x:Name="ModeArea" Stroke="#7799cc" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                    Padding="4,2" BackgroundColor="#dde6f8" VerticalOptions="Center"
                    ToolTipProperties.Text="Classic: Hold enabled, 2 previews, slower speed curve&#10;Pro: No hold, 1 preview, faster speed curve, harder level-ups">
                <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label x:Name="ClassicLabel" Text="Classic" FontSize="13" TextColor="#2060cc" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,2,0"/>
                    <Switch x:Name="ModeSwitch" IsToggled="False" Toggled="OnModeToggled" VerticalOptions="Center" Scale="0.6" Margin="-10,0,-10,0"/>
                    <Label x:Name="ProLabel" Text="Pro" FontSize="13" TextColor="#888" VerticalOptions="Center" Margin="2,0,0,0"/>
                </HorizontalStackLayout>
            </Border>
            <Button x:Name="NewGameButton" Text="New Game (N)" Clicked="OnNewGameClicked"
                    BackgroundColor="#2060cc" TextColor="White" FontSize="12" Padding="10,5"
                    IsVisible="False" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- Game Board -->
        <GraphicsView x:Name="BoardView"
                      Grid.Row="1" Grid.Column="0"
                      HorizontalOptions="End"
                      VerticalOptions="Center"
                      Margin="0,5,8,5"/>

        <!-- Right Panel: Next (top) + Score/Level/Lines + Hold -->
        <Border x:Name="RightPanel" Grid.Row="1" Grid.Column="1"
                BackgroundColor="#b8c8e8" Stroke="#7799bb" StrokeThickness="1"
                StrokeShape="RoundRectangle 8" Padding="10,6" Margin="0,0,0,0">
            <VerticalStackLayout Spacing="3" VerticalOptions="Start" MinimumWidthRequest="110">
                <Label Text="NEXT" FontSize="13" TextColor="#1a3070" HorizontalOptions="Center" FontAttributes="Bold"/>
                <Border Stroke="#4466aa" StrokeThickness="2" StrokeShape="RoundRectangle 6"
                        BackgroundColor="#d8e8ff" Padding="4" HorizontalOptions="Center">
                    <GraphicsView x:Name="NextView" WidthRequest="104" HeightRequest="150"/>
                </Border>

                <BoxView HeightRequest="1" Color="#7799bb" Margin="0,8"/>

                <Label Text="SCORE" FontSize="11" TextColor="#1a3070" HorizontalOptions="Center" FontAttributes="Bold"/>
                <Label x:Name="ScoreLabel" Text="0" FontSize="20" TextColor="#111" HorizontalOptions="Center" FontAttributes="Bold"/>

                <Label Text="LEVEL" FontSize="11" TextColor="#1a3070" HorizontalOptions="Center" FontAttributes="Bold"/>
                <Label x:Name="LevelLabel" Text="1" FontSize="20" TextColor="#111" HorizontalOptions="Center" FontAttributes="Bold"/>

                <Label Text="SPEED" FontSize="11" TextColor="#1a3070" HorizontalOptions="Center" FontAttributes="Bold"/>
                <Label x:Name="SpeedLabel" Text="1.0" FontSize="20" TextColor="#111" HorizontalOptions="Center" FontAttributes="Bold"/>

                <Label Text="LINES" FontSize="11" TextColor="#1a3070" HorizontalOptions="Center" FontAttributes="Bold"/>
                <Label x:Name="LinesLabel" Text="0" FontSize="20" TextColor="#111" HorizontalOptions="Center" FontAttributes="Bold"/>

                <Label Text="REMAINING" FontSize="10" TextColor="#1a3070" HorizontalOptions="Center" FontAttributes="Bold"/>
                <Label x:Name="RemainingLabel" Text="10" FontSize="18" TextColor="#555" HorizontalOptions="Center" FontAttributes="Bold"/>

                <BoxView HeightRequest="1" Color="#7799bb" Margin="0,8"/>

                <Label x:Name="HoldLabel" Text="HOLD" FontSize="12" TextColor="#1a3070" HorizontalOptions="Center" FontAttributes="Bold"/>
                <Border x:Name="HoldBorder" Stroke="#4466aa" StrokeThickness="1" StrokeShape="RoundRectangle 4"
                        BackgroundColor="#d8e8ff" Padding="4" HorizontalOptions="Center">
                    <GraphicsView x:Name="HoldView" WidthRequest="92" HeightRequest="63"
                                  HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- Status overlay text (TETRIS!, Level Up, PAUSED, GAME OVER) -->
        <Border x:Name="StatusBorder"
                Grid.Row="1" Grid.Column="0"
                BackgroundColor="#e0e8f8"
                Stroke="#4466aa"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 10"
                Padding="20,12"
                HorizontalOptions="Center" VerticalOptions="Center"
                ZIndex="80"
                Opacity="0.95"
                IsVisible="False">
            <Label x:Name="StatusLabel"
                   FontSize="32" TextColor="#222"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>
        </Border>

        <!-- Stats overlay (shown on game end) -->
        <Border x:Name="StatsPanel"
                Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2"
                BackgroundColor="#e8ecf8"
                Stroke="#6688aa"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 12"
                HorizontalOptions="Center" VerticalOptions="Center"
                Padding="30"
                ZIndex="90"
                IsVisible="False">
            <VerticalStackLayout Spacing="10" MinimumWidthRequest="280">
                <Label Text="GAME STATS" FontSize="24" TextColor="#2060cc" FontAttributes="Bold" HorizontalOptions="Center"/>
                <BoxView HeightRequest="1" Color="#99aacc"/>
                <Label x:Name="StatsScoreLabel" FontSize="16" TextColor="#222"/>
                <Label x:Name="StatsLevelLabel" FontSize="16" TextColor="#222"/>
                <Label x:Name="StatsLinesLabel" FontSize="16" TextColor="#222"/>
                <Label x:Name="StatsTetrisLabel" FontSize="16" TextColor="#222"/>
                <Label x:Name="StatsTimeLabel" FontSize="16" TextColor="#222"/>
                <Label x:Name="StatsModeLabel" FontSize="16" TextColor="#222"/>
                <Label x:Name="StatsRankLabel" FontSize="16" TextColor="#cc6600" FontAttributes="Bold" IsVisible="False"/>
                <BoxView HeightRequest="1" Color="#99aacc"/>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                    <Button x:Name="StatsContinueButton" Text="Continue (C)" Clicked="OnStatsContinueClicked"
                            BackgroundColor="#22aa44" TextColor="White" FontAttributes="Bold"
                            Padding="20,10" IsVisible="False"/>
                    <Button Text="Play Again (N)" Clicked="OnPlayAgainClicked"
                            BackgroundColor="#2060cc" TextColor="White" FontAttributes="Bold"
                            Padding="20,10"/>
                    <Button Text="Exit (Q)" Clicked="OnStatsExitClicked"
                            BackgroundColor="#666" TextColor="White" FontAttributes="Bold"
                            Padding="20,10"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Info/Instructions overlay panel (shown at start) -->
        <Border x:Name="InfoPanel"
                Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                BackgroundColor="#e8ecf8"
                Stroke="#6688aa"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 12"
                HorizontalOptions="Center" VerticalOptions="Center"
                Padding="30"
                ZIndex="100"
                IsVisible="True">
            <VerticalStackLayout Spacing="12" MaximumWidthRequest="420">
                <HorizontalStackLayout Spacing="10" Margin="0,0,0,0">
                    <Label Text="CONTROLS" FontSize="13" TextColor="#222" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Text="Tetris Pro" FontSize="22" TextColor="#2060cc" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="End" Margin="60,0,0,0"/>
                </HorizontalStackLayout>
                <Label FontSize="11" TextColor="#333" LineBreakMode="WordWrap"
                       Text="← / A ─ Move Left&#10;→ / D ─ Move Right&#10;↑ / W ─ Rotate&#10;↓ / S ─ Drop (tap repeatedly for fast drop)&#10;Space ─ Hold / Swap Piece&#10;Space×2 ─ Invisibility Cloak (piece passes through blocks)&#10;P / Esc ─ Pause"/>

                <Label Text="HOLD PIECE" FontSize="11" TextColor="#222" FontAttributes="Bold" Margin="0,8,0,0"/>
                <Label FontSize="10" TextColor="#333" LineBreakMode="WordWrap"
                       Text="Press Space to store the current piece. If one is already&#10;held, they swap. (Not available in Pro mode)"/>

                <Label Text="INVISIBILITY CLOAK" FontSize="11" TextColor="#222" FontAttributes="Bold" Margin="0,8,0,0"/>
                <Label FontSize="10" TextColor="#333" LineBreakMode="WordWrap"
                       Text="Double-tap Space to cloak the piece. While invisible, the&#10;piece passes through blocks and lands at the deepest&#10;valid gap. You can still move and rotate while cloaked."/>

                <Label Text="SCORING" FontSize="11" TextColor="#222" FontAttributes="Bold" Margin="0,8,0,0"/>
                <Label FontSize="10" TextColor="#333" LineBreakMode="WordWrap"
                       Text="1-3 Lines: 10 × lines cleared × level&#10;4 Lines (TETRIS!): 20 × 4 × level (double bonus!)"/>

                <Label Text="LEVELS" FontSize="11" TextColor="#222" FontAttributes="Bold" Margin="0,8,0,0"/>
                <Label FontSize="10" TextColor="#333" LineBreakMode="WordWrap"
                       Text="Clear lines to level up. Lines needed increase each level.&#10;Switch between Classic and Pro anytime using the toggle above."/>

                <Button Text="▶  Start Game (N)"
                        Clicked="OnNewGameClicked"
                        HorizontalOptions="Center"
                        Margin="0,15,0,0"
                        BackgroundColor="#2060cc"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        Padding="25,12"/>
            </VerticalStackLayout>
        </Border>

        <!-- Bottom: Controls bar with delineation -->
        <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" HorizontalOptions="Center" Spacing="4" Margin="0,10,0,0">
            <Border Stroke="#6688aa" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="6,3" BackgroundColor="#b8c8e8">
                <Label Text="←→ Move" FontSize="12" TextColor="#1a3070"/>
            </Border>
            <Border Stroke="#6688aa" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="6,3" BackgroundColor="#b8c8e8">
                <Label Text="↑ Rotate" FontSize="12" TextColor="#1a3070"/>
            </Border>
            <Border Stroke="#6688aa" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="6,3" BackgroundColor="#b8c8e8">
                <Label Text="↓ Drop" FontSize="12" TextColor="#1a3070"/>
            </Border>
            <Border x:Name="HoldKeyBorder" Stroke="#6688aa" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="6,3" BackgroundColor="#b8c8e8">
                <Label x:Name="HoldKeyLabel" Text="Space Hold" FontSize="12" TextColor="#1a3070"/>
            </Border>
            <Border Stroke="#6688aa" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="6,3" BackgroundColor="#b8c8e8">
                <Label Text="P Pause" FontSize="12" TextColor="#1a3070"/>
            </Border>
            <Border Stroke="#6688aa" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="6,3" BackgroundColor="#b8c8e8">
                <Label Text="Space×2 Cloak" FontSize="12" TextColor="#1a3070"/>
            </Border>
        </HorizontalStackLayout>

    </Grid>

</ContentPage>
